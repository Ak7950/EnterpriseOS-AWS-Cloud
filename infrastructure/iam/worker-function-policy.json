{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:${Region}:${AccountId}:log-group:/aws/lambda/enterpriseos-${Stage}-worker:*"
    },
    {
      "Sid": "ConsumeDomainEvents",
      "Effect": "Allow",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:ChangeMessageVisibility"],
      "Resource": "arn:aws:sqs:${Region}:${AccountId}:enterpriseos-${Stage}-events"
    },
    {
      "Sid": "FanOutNotifications",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:${Region}:${AccountId}:enterpriseos-${Stage}-notifications"
    }
  ]
}
