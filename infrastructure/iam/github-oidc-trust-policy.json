{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GitHubActionsOidcForThisRepositoryMainBranchOnly",
      "Effect": "Allow",
      "Principal": { "Federated": "arn:aws:iam::${AccountId}:oidc-provider/token.actions.githubusercontent.com" },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com",
          "token.actions.githubusercontent.com:sub": "repo:Ak7950/EnterpriseOS-AWS-Cloud:environment:aws-academy"
        }
      }
    }
  ]
}
