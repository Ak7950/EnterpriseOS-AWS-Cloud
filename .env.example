# Copy this file to .env for local development.
# Never commit .env or real credentials.
PORT=4000
NODE_ENV=development

# Leave blank to use the local in-memory pg-mem database.
# Set a PostgreSQL/Neon connection string only when using a persistent database.
DATABASE_URL=

# Replace with a unique random secret of at least 32 characters.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Local browser origin. Use the deployed application origin(s) in hosted environments.
CORS_ORIGIN=http://localhost:4000
